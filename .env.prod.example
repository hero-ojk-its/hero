# ==============================================================================
# HERO Backend - Konfigurasi Lingkungan Produksi (Production Environment)
# ==============================================================================
# Salin berkas ini ke `.env.prod` pada server VPS:
#   cp .env.prod.example .env.prod
#
# PENTING: Jangan pernah melakukan commit berkas `.env.prod` yang berisi kredensial asli ke git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IDENTITAS & LINGKUNGAN APLIKASI
# ------------------------------------------------------------------------------
APP_ENV=production
APP_PORT=8000
API_DOMAIN=api.hero.example.com

# Domain frontend Vercel (pisahkan dengan koma bila lebih dari satu)
# Contoh: https://hero-web.vercel.app
CORS_ORIGINS=https://hero-frontend.vercel.app

# ------------------------------------------------------------------------------
# 2. KEAMANAN & KUNCI RAHASIA (WAJIB DIGANTI!)
# ------------------------------------------------------------------------------
# Buat string acak aman (minimal 32 karakter) dengan perintah:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
SECRET_KEY=ganti-dengan-token-rahasia-minimal-32-karakter-acak-aman-1234567890
INTERNAL_API_KEY=ganti-dengan-internal-api-key-minimal-32-karakter-acak-aman-1234567890

# Perlindungan dokumen non_publik saat login dinonaktifkan (kepatuhan NDA)
AUTH_ENABLED=false
PROTECT_NON_PUBLIC_WHEN_AUTH_DISABLED=true
ACCESS_TOKEN_EXPIRE_HOURS=8

# Dokumentasi Swagger / OpenAPI (true agar dapat diakses via Caddy Basic Auth)
EXPOSE_API_DOCS=true

# ------------------------------------------------------------------------------
# 3. AUTENTIKASI BASIC AUTH UNTUK DOKUMENTASI API (/docs, /redoc, /openapi.json)
# ------------------------------------------------------------------------------
# User dan hash bcrypt untuk Caddy Basic Auth.
# Buat hash password dengan perintah:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'PasswordKuatAnda'
#
DOCS_BASIC_AUTH_USER=admin
DOCS_BASIC_AUTH_HASH=$$2a$$14$$V0ZcR3u3B4uQoW0l8gYMe5TqfG0Q0Q0Q0Q0Q0Q0Q0Q0Q0Q0Q0Q0Q

# ------------------------------------------------------------------------------
# 4. DATABASE POSTGRESQL & VECTOR EXTENSION
# ------------------------------------------------------------------------------
POSTGRES_USER=hero_user
POSTGRES_PASSWORD=ganti-dengan-password-database-yang-kuat-dan-aman
POSTGRES_DB=hero_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://hero_user:ganti-dengan-password-database-yang-kuat-dan-aman@db:5432/hero_db

# ------------------------------------------------------------------------------
# 5. STORAGE & FILE SYSTEM
# ------------------------------------------------------------------------------
STORAGE_PATH=/app/storage
MAX_UPLOAD_MB=100
LOCAL_SOURCE_ROOTS=/app/sources
LOCAL_SOURCE_MAX_FILES_PER_RUN=5000
JOB_PROGRESS_COMMIT_EVERY=10

# ------------------------------------------------------------------------------
# 6. WEB CRAWLER & PEMINDAIAN SITUS
# ------------------------------------------------------------------------------
CRAWLER_BACKEND=simple_http
CRAWL_MAX_PAGES=200
CRAWL_MAX_CANDIDATES=5000
CRAWL_DELAY_SECONDS=0.5
CRAWL_TIMEOUT_SECONDS=20
CRAWL_USER_AGENT=HERO-Capstone-Crawler/0.8 (+kontak: tim HERO)
CRAWL_RESPECT_ROBOTS=true
CRAWL_ALLOW_PRIVATE_NETWORKS=false
CRAWL_HEAD_FOR_SIZE=true
SCAN_STUCK_MINUTES=60

# ------------------------------------------------------------------------------
# 7. SERVER RUNTIME & REVERSE PROXY
# ------------------------------------------------------------------------------
# Latar belakang task berjalan in-process: 1 worker direkomendasikan untuk Fase 1
UVICORN_WORKERS=1
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12,172.17.0.0/16,172.18.0.0/16,172.19.0.0/16,172.20.0.0/14
