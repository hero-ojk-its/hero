# /opt/hero/backend/.env.prod — RAHASIA, mode 600, jangan pernah di-commit.
# Isi tanda <…> lalu hapus barisnya bila tidak dipakai.
#
# Buat nilai acak:  openssl rand -hex 32

POSTGRES_USER=hero_user
POSTGRES_PASSWORD=<acak-32-karakter>
POSTGRES_DB=hero_db
DATABASE_URL=postgresql+psycopg://hero_user:<sama-dengan-POSTGRES_PASSWORD>@db:5432/hero_db

APP_ENV=production
APP_PORT=8000
UVICORN_WORKERS=1
SECRET_KEY=<acak-64-karakter>
INTERNAL_API_KEY=<acak-64-karakter>

# Login belum aktif (keputusan Pak Faris, Weekly #3). Dokumentasi API ditutup di produksi.
AUTH_ENABLED=false
EXPOSE_API_DOCS=false

# Harus memuat asal frontend. Jangan "*" di produksi.
CORS_ORIGINS=https://hero-ojk.vercel.app,https://hero-ojk-its.github.io

# Di belakang Cloudflare Tunnel: cloudflared terhubung dari dalam, jadi proxy terlihat lokal.
FORWARDED_ALLOW_IPS=127.0.0.1

# Pemindaian dilayani worker lapisan data (hero bridge pindai), bukan crawler internal.
CRAWLER_BACKEND=push
CRAWL_ALLOW_PRIVATE_NETWORKS=false
MAX_UPLOAD_MB=100

# Layanan analisa lapisan data. docker0 = host dilihat dari dalam kontainer.
ML_SERVICE_URL=http://172.17.0.1:8100
