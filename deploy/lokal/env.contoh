# /opt/hero/.env — RAHASIA, mode 600, milik user hero. Jangan di-commit.
#
# Dua peran:
#   1. docker compose membaca berkas ini untuk mengisi ${…} di docker-compose.yml
#      (kata sandi Postgres). Berkas backend/.env.prod TIDAK dibaca untuk itu.
#   2. perintah `hero …` (lapisan data) membaca HERO_* dari sini.
#
# Buat nilai acak:  openssl rand -hex 32

# --- dipakai docker compose (harus sama dengan DATABASE_URL di backend/.env.prod)
POSTGRES_USER=hero_user
POSTGRES_PASSWORD=<acak-32-karakter>
POSTGRES_DB=hero_db

# --- dipakai lapisan data (hero bridge …)
HERO_BACKEND_URL=http://127.0.0.1:8000
HERO_BACKEND_INTERNAL_KEY=<sama-dengan-INTERNAL_API_KEY-di-env.prod>
HERO_PG_DSN=postgresql://hero_user:<sama-dengan-POSTGRES_PASSWORD>@127.0.0.1:5432/hero_db

# Asal yang boleh memanggil layanan analisa (dipakai `hero bridge serve`).
HERO_ML_CORS=https://hero-ojk.vercel.app

# Tautan berbagi OneDrive adalah bearer secret: hanya di sini, tidak pernah di YAML.
# HERO_ONEDRIVE_SHARE_URL=
