[Unit]
Description=HERO — cadangan database PostgreSQL ke Nextcloud, harian
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# Root: akses docker dan kredensial rclone.
ExecStart=/opt/hero/deploy/vps/backup-db.sh
TimeoutStartSec=2h
# Prioritas paling rendah: jangan mengganggu backend, worker, atau Nextcloud.
Nice=19
IOSchedulingClass=idle
MemoryMax=300M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
