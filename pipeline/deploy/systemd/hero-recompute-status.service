[Unit]
Description=HERO — hitung ulang status keberlakuan dokumen, harian
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# Root: perlu akses socket docker untuk exec ke kontainer backend.
ExecStart=/opt/hero/ci/recompute-status.sh
# Korpus bisa tumbuh; beri ruang dan jangan pernah dipotong di tengah penulisan
# status. Skripnya idempoten, jadi lebih baik selesai lambat daripada separuh.
TimeoutStartSec=1h
# Prioritas rendah: ini kerja latar, jangan mengganggu backend atau worker.
Nice=19
IOSchedulingClass=idle
MemoryMax=300M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
