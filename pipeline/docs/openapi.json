     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Q"
      }
     },
     {
      "name": "kategori",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "default": [],
       "title": "Kategori"
      }
     },
     {
      "name": "jenis",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "default": [],
       "title": "Jenis"
      }
     },
     {
      "name": "tahun",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "type": "integer"
       },
       "default": [],
       "title": "Tahun"
      }
     },
     {
      "name": "topik",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "default": [],
       "title": "Topik"
      }
     },
     {
      "name": "status",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "default": [],
       "title": "Status"
      }
     },
     {
      "name": "sumber",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "default": [],
       "title": "Sumber"
      }
     },
     {
      "name": "akses",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "default": [],
       "title": "Akses"
      }
     },
     {
      "name": "sort",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "terbaru",
       "title": "Sort"
      }
     },
     {
      "name": "page",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 1,
       "default": 1,
       "title": "Page"
      }
     },
     {
      "name": "page_size",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 100,
       "minimum": 1,
       "default": 8,
       "title": "Page Size"
      }
     },
     {
      "name": "mode",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "lexical",
        "lsa",
        "semantic",
        "hybrid"
       ],
       "type": "string",
       "default": "lexical",
       "title": "Mode"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/KbListResponse"
        }
       }
      }
     },
