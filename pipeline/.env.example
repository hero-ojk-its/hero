# Salin ke .env (tidak di-commit) lalu isi nilainya.

# Tautan berbagi folder OneDrive DPEA ("Anyone with the link").
# Ini rahasia pembawa: siapa pun yang memegangnya bisa membaca seluruh folder.
HERO_ONEDRIVE_SHARE_URL=

# Opsional — lapisan AI-Assisted (Fase 2). Mode Deterministik tidak membutuhkannya.
ANTHROPIC_API_KEY=

# Opsional — jalankan CLI dari folder mana pun; path data tetap relatif ke folder kerja.
# HERO_CONFIG=/path/ke/workspace/config/sources.yaml

# --- Jembatan ke backend tim (hero bridge ...) -----------------------------
# URL backend FastAPI dan kunci API internalnya. Kunci ini memberi akses ke
# seluruh endpoint /api/v1/internal/* — perlakukan seperti kata sandi.
HERO_BACKEND_URL=http://127.0.0.1:8000
HERO_BACKEND_INTERNAL_KEY=
# DSN Postgres backend — hanya dibutuhkan untuk `hero bridge sinkron`,
# `vektor-isi`, `/api/v1/ml/pasal-mirip`, dan `hero bench vektor --pg`.
# HERO_PG_DSN=postgresql://hero_user:hero_password@127.0.0.1:5432/hero_db
