# ===== DATABASE =====
POSTGRES_USER=hero_user
POSTGRES_PASSWORD=hero_password
POSTGRES_DB=hero_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://hero_user:hero_password@localhost:5432/hero_db

# ===== APLIKASI =====
APP_ENV=development
APP_PORT=8000
SECRET_KEY=ganti-dengan-secret-key-rahasia-yang-panjang-minimal-32-karakter
INTERNAL_API_KEY=ganti-dengan-key-acak-yang-panjang

# ===== AUTH & KEAMANAN =====
# False = login dinonaktifkan (semua endpoint terbuka, sesuai MoM 22 Sep 2026)
# True = otentikasi JWT aktif
AUTH_ENABLED=false
ACCESS_TOKEN_EXPIRE_HOURS=8
CORS_ORIGINS=*

# ===== STORAGE & UPLOAD =====
# Gunakan ./storage untuk menjalankan aplikasi secara lokal
# Gunakan /app/storage saat berjalan di dalam container Docker
STORAGE_PATH=./storage
MAX_UPLOAD_MB=100

# ===== PENAMAAN BAKU & STRUKTUR FOLDER KB (Langkah 3) =====
# Template penamaan file PDF baku. Placeholder yang diizinkan: {nomor}, {judul}, {tahun}, {jenis}
NAMING_TEMPLATE="{nomor} {judul} {tahun}"
# Nilai pengganti unsur yang tidak diketahui (hindari karakter ilegal OS seperti *)
NAMING_WILDCARD=NA
# Batas panjang maksimal nama file termasuk ekstensi .pdf
NAMING_MAX_LENGTH=150
# Template jalur kategori KB. Placeholder yang diizinkan: {jenis}, {tahun}
CATEGORY_PATH_TEMPLATE="{jenis}/{tahun}"
# Nilai pengganti jika {jenis} tidak diketahui
CATEGORY_UNKNOWN_TYPE=Lainnya
# Nilai pengganti jika {tahun} tidak diketahui
CATEGORY_UNKNOWN_YEAR=Tanpa Tahun
# Nama root folder khusus untuk dokumen draft kajian (ADR-03)
DRAFT_CATEGORY_ROOT="Draft Kajian"

# ===== EKSTRAKSI DATA/ML & METADATA (Langkah 5) =====
# Field hasil ekstraksi dengan confidence di bawah threshold ini ditandai low_confidence_fields (perlu koreksi)
METADATA_CONFIDENCE_THRESHOLD=0.7
# Batas waktu klaim antrean ekstraksi (menit) sebelum dianggap kedaluwarsa dan boleh diklaim ulang
EXTRACTION_CLAIM_TIMEOUT_MINUTES=30
# Batas maksimal percobaan ekstraksi sebelum dokumen tidak lagi diklaim otomatis
EXTRACTION_MAX_ATTEMPTS=3

# ===== SUMBER FOLDER LOKAL (Langkah 6) =====
# Daftar akar folder lokal yang diizinkan untuk didaftarkan sebagai sumber (dipisah ;)
# Di lingkungan Docker, gunakan /app/sources
LOCAL_SOURCE_ROOTS="./sources"
# Batas maksimal berkas yang diproses per satu kali eksekusi sinkronisasi folder
LOCAL_SOURCE_MAX_FILES_PER_RUN=5000
# Interval penyimpanan/commit progres job ke database (setiap N berkas)
JOB_PROGRESS_COMMIT_EVERY=10

# ===== ALUR PINDAI SITUS / CRAWLER (Langkah 7) =====
# Backend crawler: simple_http | external_module | push
CRAWLER_BACKEND=simple_http
# Modul crawler eksternal (jika CRAWLER_BACKEND=external_module, contoh: paket.modul:NamaKelas)
CRAWLER_MODULE=
# Batas halaman HTML yang dijelajahi per sesi pindai
CRAWL_MAX_PAGES=200
# Batas kandidat PDF yang dicatat per sesi pindai
CRAWL_MAX_CANDIDATES=5000
# Jeda antar-request HTTP ke host yang sama (detik)
CRAWL_DELAY_SECONDS=0.5
# Timeout per request HTTP crawler (detik)
CRAWL_TIMEOUT_SECONDS=20
# User-Agent crawler HERO
CRAWL_USER_AGENT="HERO-Capstone-Crawler/0.7 (+kontak: tim HERO)"
# Menghormati aturan robots.txt situs target
CRAWL_RESPECT_ROBOTS=true
# Mengizinkan request ke alamat IP privat/loopback (HANYA untuk dev/test lokal, default false demi keamanan SSRF)
CRAWL_ALLOW_PRIVATE_NETWORKS=false
# Melakukan HEAD request untuk mengecek ukuran Content-Length dan Content-Disposition
CRAWL_HEAD_FOR_SIZE=true
# Waktu (menit) batas pemulihan sesi pindai yang macet saat startup
SCAN_STUCK_MINUTES=60

